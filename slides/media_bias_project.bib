	keywords = {Accountability, Corruption, Voting},
	file = {ScienceDirect Snapshot:C\:\\Users\\mruli\\Zotero\\storage\\H8JMN828\\S0176268012000353.html:text/html},
}

@article{stanig2015regulation,
	title = {Regulation of Speech and Media Coverage of Corruption: An Empirical Analysis of the Mexican Press},
